---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar';
import HeroSection from '../components/HeroSection';
import StoresDZShowcase from '../components/StoresDZShowcase';
import SystemsBento from '../components/SystemsBento';
import InteractiveTerminal from '../components/InteractiveTerminal';
import Footer from '../components/Footer';
import { GitBranch, Layers, ArrowUpRight } from 'lucide-react';
---

<BaseLayout
  title="NextPaper.dev — High-Performance Systems & Software Studio"
  description="NextPaper is a high-profile systems development collective. Engineering hyper-scalable Go distributed backends, Rust edge compilers, and StoresDZ multi-tenant commerce."
>
  <!-- Global Navigation -->
  <Navbar client:load />

  <main>
    <!-- Hero Section with Origami Engine & Telemetry -->
    <HeroSection client:load />

    <!-- Flagship Product: StoresDZ Deep-Dive -->
    <StoresDZShowcase client:visible />

    <!-- Architectural Blueprint Section -->
    <section id="architecture" class="py-24 relative border-t border-white/[0.06] bg-[#07080a]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col items-center text-center mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/50 border border-cyan-500/30 text-cyan-300 text-xs font-mono tracking-widest uppercase mb-4">
            <Layers className="w-3.5 h-3.5 text-cyan-400" />
            <span>NextPaper Architecture</span>
          </div>

          <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
            Unified Distributed <span class="text-gradient-silver">Topologies</span>
          </h2>
          <p class="max-w-2xl text-base sm:text-lg text-zinc-400">
            How NextPaper architectures harmonize sub-millisecond edge compilation with transactional consistency.
          </p>
        </div>

        {/* Visual Architecture Flow Diagram */}
        <div class="p-6 sm:p-10 rounded-2xl bg-[#0c0e14] border border-white/[0.1] shadow-2xl relative overflow-hidden">
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 relative z-10">
            
            {/* Step 1: Ingestion & Edge */}
            <div class="p-5 rounded-xl bg-[#12151e] border border-white/[0.06] flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-cyan-400 uppercase tracking-wider mb-2">01 // EDGE LAYER</div>
                <h3 class="text-base font-bold text-white mb-1">Rust Funnel Cache</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Actix &amp; Axum powered edge runtime delivering static HTML compiled from Liquid AST in under 1 millisecond.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-white/[0.06] text-[11px] font-mono text-zinc-400 flex items-center justify-between">
                <span>Latency</span>
                <span class="text-cyan-400 font-bold">&lt; 1 ms</span>
              </div>
            </div>

            {/* Step 2: Protocol Handshake */}
            <div class="p-5 rounded-xl bg-[#12151e] border border-white/[0.06] flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-orange-400 uppercase tracking-wider mb-2">02 // RUNTIME SDK</div>
                <h3 class="text-base font-bold text-white mb-1">Funnel SDK v1.2</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  12KB browser SDK initiating cryptographic quotes, delivery calculations, and safe attempt verification.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-white/[0.06] text-[11px] font-mono text-zinc-400 flex items-center justify-between">
                <span>Bundle</span>
                <span class="text-orange-400 font-bold">12.4 KB gzip</span>
              </div>
            </div>

            {/* Step 3: High-Concurrency Core */}
            <div class="p-5 rounded-xl bg-[#12151e] border border-white/[0.06] flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-emerald-400 uppercase tracking-wider mb-2">03 // CORE ENGINE</div>
                <h3 class="text-base font-bold text-white mb-1">Go 1.22 API Core</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Multi-tenant Gin routing with type-safe sqlc PostgreSQL pools, Casbin RBAC, and zero ORM latency.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-white/[0.06] text-[11px] font-mono text-zinc-400 flex items-center justify-between">
                <span>Throughput</span>
                <span class="text-emerald-400 font-bold">25k+ req/s</span>
              </div>
            </div>

            {/* Step 4: Event Mesh */}
            <div class="p-5 rounded-xl bg-[#12151e] border border-white/[0.06] flex flex-col justify-between">
              <div>
                <div class="text-[10px] font-mono text-purple-400 uppercase tracking-wider mb-2">04 // STREAMING BUS</div>
                <h3 class="text-base font-bold text-white mb-1">NATS JetStream</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Asynchronous durable event logging, order dispatch, delivery carrier sync, and real-time merchant alerts.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-white/[0.06] text-[11px] font-mono text-zinc-400 flex items-center justify-between">
                <span>Durability</span>
                <span class="text-purple-400 font-bold">At-Least-Once</span>
              </div>
            </div>

          </div>

          {/* Architecture Bottom Banner */}
          <div class="mt-8 p-4 rounded-xl bg-[#141824] border border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="p-2 rounded-lg bg-cyan-950/80 text-cyan-400 border border-cyan-800/40">
                <GitBranch className="w-4 h-4" />
              </span>
              <span class="text-xs text-zinc-300 font-mono">
                Architecture validated across enterprise multi-tenant deployments and edge clusters.
              </span>
            </div>
            <a
              href="https://github.com/Storesdz"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400 hover:text-cyan-300 group"
            >
              <span>Inspect Source Repos</span>
              <ArrowUpRight className="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </a>
          </div>

        </div>

      </div>
    </section>

    <!-- Systems DNA Bento Grid -->
    <SystemsBento client:visible />

    <!-- Interactive Terminal Console -->
    <InteractiveTerminal client:visible />

    <!-- Call to Action Banner -->
    <section class="py-20 relative border-t border-white/[0.06] overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/5 via-orange-500/5 to-cyan-500/5 pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10">
        <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-6">
          Ready to Build Systems That <span class="text-gradient-cyan-amber">Scale Without Limits?</span>
        </h2>
        <p class="text-zinc-400 text-base sm:text-lg mb-8 max-w-xl mx-auto">
          Whether you need low-latency edge rendering, high-concurrency Go microservices, 
          or turnkey multi-tenant SaaS architecture, NextPaper delivers.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="mailto:rafafaycal@gmail.com"
            class="px-8 py-3.5 rounded-xl bg-white text-black font-semibold text-sm hover:bg-zinc-200 transition-all shadow-[0_0_30px_rgba(255,255,255,0.3)] hover:shadow-[0_0_40px_rgba(0,229,255,0.5)]"
          >
            Initiate Architecture Inquiries
          </a>
          <a
            href="https://github.com/NextPaper-dev"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-xl bg-[#12151e] text-zinc-300 hover:text-white font-medium text-sm border border-white/[0.1] hover:border-white/[0.2] transition-colors"
          >
            Explore NextPaper GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Global Footer -->
  <Footer client:visible />
</BaseLayout>
