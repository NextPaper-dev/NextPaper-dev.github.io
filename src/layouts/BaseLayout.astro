---
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "NextPaper.dev — High-Performance Systems & Modern Commerce Infrastructure",
  description = "NextPaper is a high-profile systems engineering studio. Architects of hyper-scalable Go backends, Rust edge engines, and StoresDZ multi-tenant commerce."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/assets/nextpaper-icon.jpg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07080a" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nextpaper.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/nextpaper-logo.jpg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://nextpaper.dev/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/assets/nextpaper-logo.jpg" />

    <!-- Modern Typography Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-np-bg text-np-text antialiased selection:bg-cyan-500/30 selection:text-white relative min-h-screen">
    <!-- Top Ambient Glow Field -->
    <div class="pointer-events-none fixed inset-0 z-0 bg-blueprint opacity-60"></div>
    <div class="pointer-events-none fixed -top-[200px] left-1/2 -translate-x-1/2 w-[1100px] h-[600px] bg-gradient-to-b from-cyan-500/10 via-orange-500/5 to-transparent blur-3xl -z-10 rounded-full"></div>
    
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>
